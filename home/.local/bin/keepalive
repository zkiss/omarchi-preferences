#!/usr/bin/env bash
usage() {
  printf 'Usage: keepalive -u <url> [-t <seconds>]\n' >&2
  exit 2
}
URL=''
DELAY=60
while getopts ':u:t:' option; do
  case "$option" in
    u) URL=$OPTARG ;;
    t) DELAY=$OPTARG ;;
    *) usage ;;
  esac
done
shift "$((OPTIND - 1))"
[[ -n $URL && $# == 0 && $DELAY =~ ^[0-9]+([.][0-9]+)?$ ]] || usage
while :; do
  printf 'Pinging %s\n' "$URL"
  curl -- "$URL"
  printf '\n'
  sleep "$DELAY"
done
