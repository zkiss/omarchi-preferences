#!/bin/bash

# Keep a manually enabled keyboard backlight from being replaced by the
# stale level Omarchy saved when the lock screen blanked it.
omarchy-brightness-display on

for candidate in /sys/class/leds/*kbd_backlight*; do
  [[ -e $candidate ]] || continue
  device="$(basename "$candidate")"
  if [[ $(brightnessctl -d "$device" get) -eq 0 ]]; then
    omarchy-brightness-keyboard restore
  fi
  break
done

omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || true
