#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dry_run=false
system=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --system) system=true ;;
    -h|--help)
      printf 'Usage: ./apply [--dry-run] [--system]\n\nDeploy user preferences; --system also installs /etc drop-ins using sudo.\n'
      printf 'Also install and enable the plugins listed in plugins.manifest.\n'
      exit 0 ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

[[ -d /usr/share/omarchy ]] || { printf 'An Omarchy installation is required.\n' >&2; exit 1; }
[[ ${HOME:-} == /* && $HOME != / ]] || { printf 'HOME must be an absolute user home directory.\n' >&2; exit 1; }
(( EUID != 0 )) || { printf 'Run as your normal user; --system invokes sudo when needed.\n' >&2; exit 1; }

backup=''
temporary=''
trap '[[ -z "$temporary" ]] || rm -f -- "$temporary"' EXIT

backup_file() {
  local target=$1 relative=$2 privileged=$3
  [[ -e $target || -L $target ]] || return 0
  if [[ -z $backup ]]; then
    mkdir -p -- "$HOME/.local/state/omarchy-preferences/backups"
    backup=$(mktemp -d "$HOME/.local/state/omarchy-preferences/backups/$(date +%Y%m%d-%H%M%S).XXXXXX")
  fi
  mkdir -p -- "$(dirname -- "$backup/$relative")"
  [[ ! -e $backup/$relative && ! -L $backup/$relative ]] || return 0
  if $privileged; then
    sudo cp -a -- "$target" "$backup/$relative"
  else
    cp -a -- "$target" "$backup/$relative"
  fi
}

deploy() {
  local source=$1 target=$2 mode=$3 relative=$4 privileged=$5
  # Replace links with regular managed files; never write through an existing link.
  if [[ -f $target && ! -L $target ]] && cmp -s -- "$source" "$target" \
    && [[ $(stat -c '%a' -- "$target") == "$mode" ]]; then
    printf 'Unchanged: %s\n' "$target"
    return
  fi
  [[ ! -d $target || -L $target ]] || { printf 'Refusing to replace directory: %s\n' "$target" >&2; exit 1; }
  printf 'Install:   %s\n' "$target"
  $dry_run && return
  backup_file "$target" "$relative" "$privileged"
  if $privileged; then
    sudo mkdir -p -- "$(dirname -- "$target")"
    sudo rm -f -- "$target"
    sudo install -m "$mode" -- "$source" "$target"
  else
    mkdir -p -- "$(dirname -- "$target")"
    rm -f -- "$target"
    install -m "$mode" -- "$source" "$target"
  fi
}

# Install plugins before bindings so their manifests exist when Hyprland reloads.
for dependency in git jq omarchy; do
  command -v "$dependency" >/dev/null || { printf 'Required command missing: %s\n' "$dependency" >&2; exit 1; }
done
while read -r id url branch; do
  [[ -n $id && $id != \#* ]] || continue
  [[ $id =~ ^[a-zA-Z0-9_-]+\.[a-zA-Z0-9_.-]+$ && $id != *..* && $url == https://github.com/* && -n $branch ]] || {
    printf 'Invalid plugin manifest entry: %s\n' "$id" >&2; exit 1;
  }
  target="$HOME/.config/omarchy/plugins/$id"
  origin=$(git -C "$target" remote get-url origin 2>/dev/null || true)
  current_branch=$(git -C "$target" branch --show-current 2>/dev/null || true)
  replace=false
  if [[ ! -f $target/manifest.json || $origin != "$url" ]] \
    || [[ $branch != - && $current_branch != "$branch" ]]; then
    replace=true
    printf 'Plugin:    install %s from %s (%s)\n' "$id" "$url" "$branch"
  else
    printf 'Unchanged: plugin %s\n' "$id"
  fi
  enabled=false
  if [[ -f $HOME/.config/omarchy/shell.json ]] && jq -e --arg id "$id" \
    'any(.plugins[]?; .id == $id and .enabled != false)' "$HOME/.config/omarchy/shell.json" >/dev/null; then
    enabled=true
  fi
  if $replace || ! $enabled; then
    printf 'Plugin:    enable %s\n' "$id"
    if ! $dry_run; then
      backup_file "$HOME/.config/omarchy/shell.json" home/.config/omarchy/shell.json false
      if $replace; then
        # Preserve the entire previous checkout, including uncommitted changes.
        if [[ -e $target || -L $target ]]; then
          backup_file "$target" "home/.config/omarchy/plugins/$id" false
          rm -rf -- "$target"
        fi
        omarchy plugin add "$url" --yes
        if [[ $branch != - ]]; then
          git -C "$target" switch -- "$branch"
          omarchy-shell shell rescanPlugins >/dev/null
        fi
        [[ $(jq -r .id "$target/manifest.json") == "$id" ]] || {
          printf 'Unexpected plugin ID in %s\n' "$target" >&2; exit 1;
        }
      fi
      omarchy plugin enable "$id"
    fi
  fi
done < "$ROOT/plugins.manifest"

while read -r mode path; do
  [[ -n $mode && $mode != \#* ]] || continue
  [[ $path != /* && $path != *..* && -f $ROOT/home/$path ]] || { printf 'Invalid home manifest entry: %s\n' "$path" >&2; exit 1; }
  deploy "$ROOT/home/$path" "$HOME/$path" "$mode" "home/$path" false
done < "$ROOT/home.manifest"

# gitconfig.zsh used to initialise this on every shell startup. Do it at apply.
excludes=$(git config --global --get core.excludesfile || true)
if [[ -z $excludes ]]; then
  excludes="$HOME/.gitignore_global"
  printf 'Git:       initialise global excludes file %s\n' "$excludes"
  if ! $dry_run; then
    # Preserve the conventional global config before changing one setting.
    backup_file "${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}" home/.gitconfig false
    backup_file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" home/.config/git/config false
    git config --global core.excludesfile "$excludes"
  fi
fi
excludes=${excludes/#\~\//$HOME/}
if [[ ! -e $excludes ]]; then
  printf 'Git:       create empty excludes file %s\n' "$excludes"
  if ! $dry_run; then
    mkdir -p -- "$(dirname -- "$excludes")"
    touch -- "$excludes"
  fi
fi

# Preserve the existing Omarchy bootstrap and local setup in .bashrc.
loader='[[ -r "$HOME/.config/bash/preferences.bash" ]] && source "$HOME/.config/bash/preferences.bash"'
if [[ ! -f $HOME/.bashrc ]] || ! grep -Fxq -- "$loader" "$HOME/.bashrc"; then
  printf 'Append:    Bash preferences loader to %s/.bashrc\n' "$HOME"
  if ! $dry_run; then
    temporary=$(mktemp)
    if [[ -e $HOME/.bashrc ]]; then
      cat -- "$HOME/.bashrc" > "$temporary"
    else
      cat -- "$ROOT/templates/bashrc" > "$temporary"
    fi
    printf '\n# Personal preferences (omarchy-preferences)\n%s\n' "$loader" >> "$temporary"
    deploy "$temporary" "$HOME/.bashrc" 644 home/.bashrc false
    rm -f -- "$temporary"
    temporary=''
  fi
fi

if $system; then
  while read -r mode path; do
    [[ -n $mode && $mode != \#* ]] || continue
    [[ $path != /* && $path != *..* && -f $ROOT/system/$path ]] || { printf 'Invalid system manifest entry: %s\n' "$path" >&2; exit 1; }
    deploy "$ROOT/system/$path" "/$path" "$mode" "system/$path" true
  done < "$ROOT/system.manifest"
fi

[[ -z $backup ]] || printf '\nBackups: %s\n' "$backup"
if $dry_run; then
  printf '\nDry run complete; no changes made.\n'
else
  printf '\nApplied. Open a new terminal for Bash/Foot changes.\n'
  printf 'Validate Hyprland with: hyprctl reload && hyprctl configerrors\n'
  if $system; then
    printf 'Reboot to activate changed logind settings.\n'
  fi
fi
