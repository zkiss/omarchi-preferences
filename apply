#!/bin/sh
set -eu

ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)

mkdir -p "$HOME/.config/hypr"

# Load the preferences entry point from interactive Bash shells, once only.
loader="preferences_directory='$ROOT/sh'; . '$ROOT/sh/preferences.sh'"
touch "$HOME/.bashrc"
if ! grep -Fqx -- "$loader" "$HOME/.bashrc"; then
  printf '\n# sh-preferences\n%s\n' "$loader" >> "$HOME/.bashrc"
fi

path_line="export PATH=\"$ROOT/bin:\$PATH\""
if ! grep -Fqx -- "$path_line" "$HOME/.bashrc"; then
  printf '%s\n' "$path_line" >> "$HOME/.bashrc"
fi

cp -p "$ROOT/hypr/bindings.lua" "$HOME/.config/hypr/bindings.lua"

while read -r id url branch || [ -n "${id:-}" ]; do
  [ -n "${id:-}" ] || continue
  case $id in \#*) continue ;; esac
  target="$HOME/.config/omarchy/plugins/$id"
  if [ ! -d "$target" ]; then
    omarchy plugin add "$url" --yes
  fi
  if [ "$branch" != - ]; then
    git -C "$target" switch -- "$branch"
    omarchy-shell shell rescanPlugins >/dev/null
  fi
  omarchy plugin enable "$id"
done < "$ROOT/plugins.manifest"

find "$ROOT/system" -type f -print | while IFS= read -r file; do
  target="/${file#"$ROOT/system/"}"
  sudo mkdir -p "$(dirname "$target")"
  sudo cp -p "$file" "$target"
done

printf 'Preferences installed. Open a new shell to load Bash changes.\n'
